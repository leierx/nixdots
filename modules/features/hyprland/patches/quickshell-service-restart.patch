 }
 
+void Bluez::onServiceRegistered() {
+	qCDebug(logBluetooth) << "BlueZ service registered";
+	this->objectManager->setInterface("org.bluez", "/", QDBusConnection::systemBus());
+}
+
+void Bluez::onServiceUnregistered() {
+	qCDebug(logBluetooth) << "BlueZ service unregistered";
+
+	for (const auto& path: this->mDeviceMap.keys()) {
+		this->onInterfacesRemoved(QDBusObjectPath(path), {"org.bluez.Device1"});
+	}
+
+	for (const auto& path: this->mAdapterMap.keys()) {
+		this->onInterfacesRemoved(QDBusObjectPath(path), {"org.bluez.Adapter1"});
+	}
+}
