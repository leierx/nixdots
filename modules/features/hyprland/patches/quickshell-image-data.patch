diff -ru a/src/services/notifications/dbusimage.cpp b/src/services/notifications/dbusimage.cpp
--- a/src/services/notifications/dbusimage.cpp
+++ b/src/services/notifications/dbusimage.cpp
@@ -15,12 +15,15 @@
 QS_DECLARE_LOGGING_CATEGORY(logNotifications); // server.cpp
 
 QImage DBusNotificationImage::createImage() const {
+	if (this->data.isEmpty()) return QImage();
 	auto format = this->hasAlpha ? QImage::Format_RGBA8888 : QImage::Format_RGB888;
 
+	// The rows as the client laid them out, padded or not; without a stride QImage assumes 32-bit rows.
 	return QImage(
 	    reinterpret_cast<const uchar*>(this->data.data()),
 	    this->width,
 	    this->height,
+	    this->rowstride,
 	    format
 	);
 }
@@ -29,22 +32,33 @@
 	argument.beginStructure();
 	argument >> pixmap.width;
 	argument >> pixmap.height;
-	auto rowstride = qdbus_cast<qint32>(argument);
+	pixmap.rowstride = qdbus_cast<qint32>(argument);
+	auto rowstride = pixmap.rowstride;
 	argument >> pixmap.hasAlpha;
 	auto sampleBits = qdbus_cast<qint32>(argument);
 	auto channels = qdbus_cast<qint32>(argument);
 	argument >> pixmap.data;
 	argument.endStructure();
 
+	// One that does not parse is dropped: drawn anyway, its sizes would read past its bytes.
 	if (sampleBits != 8) {
 		qCWarning(logNotifications) << "Unable to parse pixmap as sample count is incorrect. Got"
 		                            << sampleBits << "expected" << 8;
+		pixmap.data.clear();
 	} else if (channels != (pixmap.hasAlpha ? 4 : 3)) {
 		qCWarning(logNotifications) << "Unable to parse pixmap as channel count is incorrect."
 		                            << "Got " << channels << "expected" << (pixmap.hasAlpha ? 4 : 3);
-	} else if (rowstride != pixmap.width * channels) {
-		qCWarning(logNotifications) << "Unable to parse pixmap as rowstride is incorrect. Got"
-		                            << rowstride << "expected" << (pixmap.width * channels);
+		pixmap.data.clear();
+	} else if (pixmap.width <= 0 || pixmap.height <= 0 || rowstride < pixmap.width * channels) {
+		qCWarning(logNotifications) << "Unable to parse pixmap as its size is incorrect. Got"
+		                            << pixmap.width << "x" << pixmap.height << "rowstride" << rowstride;
+		pixmap.data.clear();
+	} else if (pixmap.data.size()
+	           < static_cast<qint64>(rowstride) * (pixmap.height - 1) + pixmap.width * channels)
+	{
+		qCWarning(logNotifications) << "Unable to parse pixmap as it holds" << pixmap.data.size()
+		                            << "bytes, too few for" << pixmap.width << "x" << pixmap.height;
+		pixmap.data.clear();
 	}
 
 	return argument;
@@ -54,7 +68,7 @@
 	argument.beginStructure();
 	argument << pixmap.width;
 	argument << pixmap.height;
-	argument << pixmap.width * (pixmap.hasAlpha ? 4 : 3);
+	argument << pixmap.rowstride;
 	argument << pixmap.hasAlpha;
 	argument << 8;
 	argument << (pixmap.hasAlpha ? 4 : 3);
